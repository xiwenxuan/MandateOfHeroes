* text=auto

*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.shader text eol=lf
*.cginc text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.ttf binary
*.otf binary

# Runtime/reference data packages carry byte counts and SHA-256 manifests.
# Preserve their exact generated bytes so a fresh checkout keeps those
# integrity contracts valid. Source code and ordinary documentation remain
# normalized by the rules above.
Assets/StreamingAssets/** binary
MapData/** binary
Data/** binary

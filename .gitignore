# Unity generated directories
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Bb]uild/
[Bb]uilds/
[Ee]xportedObj/
[Cc]rash_Reports/
tmp/
outputs/

# Unity Test Framework bootstrap scenes left behind by interrupted test runs.
# Keep them out of version control, and move them out of Assets with
# Tools/Quarantine-UnityGeneratedTestScenes.ps1 so Unity does not import them.
Assets/InitTestScene*.unity
Assets/InitTestScene*.unity.meta

# Reproducible local evidence, previews and Python/Node caches
**/__pycache__/
*.py[cod]
**/.cache/
**/cache/
**/artifact_tool_sidecars/
**/*.inspect.ndjson
**/previews/
**/workbook_previews/
**/renders/

# Large reproducible V72 arena/training evidence. Keep aggregate reports,
# versioned model weights and schemas; regenerate raw rows through the tests.
Docs/HISTORICAL_WORLD_REFERENCE/WORLD_INTELLIGENT_DECISION_POLICY_AND_SIMULATION_ARENA_V1/ARENA/*.jsonl
Docs/HISTORICAL_WORLD_REFERENCE/WORLD_INTELLIGENT_DECISION_POLICY_AND_SIMULATION_ARENA_V1/ARENA/arena_metrics.csv
Docs/HISTORICAL_WORLD_REFERENCE/WORLD_INTELLIGENT_DECISION_POLICY_AND_SIMULATION_ARENA_V1/MODEL/training_dataset.jsonl

# Reproducible map-pipeline caches and large intermediate GIS files
MapPipeline/.python/
MapPipeline/.cache/
MapPipeline/sources/cache/
MapData/**/working/
MapData/**/candidates/raw/

